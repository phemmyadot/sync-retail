// Sync Retail — PostgreSQL schema
// Money is stored as integer cents; rates as integer basis points (825 = 8.25%).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SALES_AGENT
}

enum SaleStatus {
  COMPLETED
  VOIDED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  LOYALTY
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum OverrideAction {
  REMOVE_ITEM
  DECREASE_QTY
  CLEAR_CART
  PRICE_DISCOUNT
  VOID_SALE
  RETURN_ITEM
  EDIT_SALE
}

enum OverrideOutcome {
  APPROVED
  DENIED
}

enum StockMovementType {
  SALE
  RETURN
  VOID
  ADJUSTMENT
  IMPORT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  pinHash      String
  role         Role     @default(SALES_AGENT)
  color        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales              Sale[]          @relation("SaleCashier")
  overridesRequested OverrideLog[]   @relation("OverrideRequester")
  overridesApproved  OverrideLog[]   @relation("OverrideApprover")
  refunds            Refund[]
  stockMovements     StockMovement[]
  imports            ImportBatch[]
  auditLogs          AuditLog[]
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id                String    @id @default(cuid())
  sku               String    @unique
  barcode           String?   @unique
  name              String
  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costCents         Int       @default(0)
  priceCents        Int
  taxRateBps        Int       @default(0)
  stockQty          Int       @default(0)
  lowStockThreshold Int       @default(5)
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@index([name])
  @@index([categoryId])
  @@index([updatedAt])
}

model Customer {
  id                 String   @id @default(cuid())
  name               String
  phone              String?  @unique
  email              String?  @unique
  lifetimeSpendCents Int      @default(0)
  pointsBalance      Int      @default(0)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sales         Sale[]
  loyaltyLedger LoyaltyTransaction[]

  @@index([name])
}

model Sale {
  id             String     @id @default(cuid())
  receiptNo      String     @unique
  /// Idempotency key generated by the terminal; lets offline sales replay safely.
  clientId       String     @unique
  terminalId     String?
  status         SaleStatus @default(COMPLETED)
  cashierId      String
  cashier        User       @relation("SaleCashier", fields: [cashierId], references: [id])
  customerId     String?
  customer       Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  subtotalCents  Int
  discountCents  Int        @default(0)
  taxCents       Int
  totalCents     Int
  refundedCents  Int        @default(0)
  pointsEarned   Int        @default(0)
  pointsRedeemed Int        @default(0)
  offline        Boolean    @default(false)
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime   @default(now())
  syncedAt       DateTime   @default(now())

  items     SaleItem[]
  payments  Payment[]
  overrides OverrideLog[]
  refunds   Refund[]
  loyalty   LoyaltyTransaction[]

  @@index([createdAt])
  @@index([cashierId])
  @@index([status])
}

model SaleItem {
  id             String        @id @default(cuid())
  saleId         String
  sale           Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  // Snapshots so history survives later catalog edits.
  sku            String
  name           String
  categoryName   String?
  costCents      Int           @default(0)
  unitPriceCents Int
  quantity       Int
  returnedQty    Int           @default(0)
  discountType   DiscountType?
  discountValue  Int           @default(0)
  discountCents  Int           @default(0)
  taxRateBps     Int
  taxCents       Int
  totalCents     Int
  refunds        Refund[]

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id            String        @id @default(cuid())
  saleId        String
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  amountCents   Int
  tenderedCents Int?
  changeCents   Int           @default(0)
  pointsUsed    Int           @default(0)
  reference     String?
  createdAt     DateTime      @default(now())

  @@index([saleId])
}

model Refund {
  id            String   @id @default(cuid())
  saleId        String
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleItemId    String
  saleItem      SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  quantity      Int
  amountCents   Int
  reason        String?
  restock       Boolean  @default(true)
  processedById String
  processedBy   User     @relation(fields: [processedById], references: [id])
  overrideId    String?
  createdAt     DateTime @default(now())
}

/// Every manager-override attempt — approved or denied — for auditing.
model OverrideLog {
  id            String          @id @default(cuid())
  action        OverrideAction
  outcome       OverrideOutcome
  reason        String?
  requestedById String
  requestedBy   User            @relation("OverrideRequester", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?           @relation("OverrideApprover", fields: [approvedById], references: [id])
  saleId        String?
  sale          Sale?           @relation(fields: [saleId], references: [id], onDelete: SetNull)
  context       Json?
  ipAddress     String?
  consumedAt    DateTime?
  createdAt     DateTime        @default(now())

  @@index([createdAt])
  @@index([action])
}

model LoyaltyTransaction {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  saleId     String?
  sale       Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
  points     Int
  reason     String
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model StockMovement {
  id        String            @id @default(cuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      StockMovementType
  quantity  Int
  reference String?
  userId    String?
  user      User?             @relation(fields: [userId], references: [id])
  createdAt DateTime          @default(now())

  @@index([productId, createdAt])
}

model ImportBatch {
  id        String   @id @default(cuid())
  fileName  String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  mode      String
  created   Int
  updated   Int
  skipped   Int
  createdAt DateTime @default(now())
}

/// General-purpose audit trail (logins, catalog edits, settings changes…).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
