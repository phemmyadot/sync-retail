# PostgreSQL connection (Neon / Supabase / local). For Neon use the pooled URL + ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sync_retail?schema=public"

# Long random string — `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET="change-me-to-a-long-random-string"

PORT=4000
# Comma-separated list of allowed browser origins (Vite dev, Tauri webview)
CORS_ORIGIN="http://localhost:5173,http://tauri.localhost,tauri://localhost"

# Session length for logged-in staff, and lifetime of a manager-override approval
SESSION_TTL="12h"
OVERRIDE_TTL_SECONDS=300
