# Docker Compose settings — copy to .env (`cp .env.example .env`) and change the secrets.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sync_retail

# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Demo staff/catalog/sales on first start (only while the database is empty).
# WARNING: the demo logins and PINs are published in the README — never enable this for a real store.
SEED_DEMO_DATA=false

# Without demo data, the first visit to the web app runs the owner setup wizard. It only works
# while the store has no users, so finish setup right after starting. Set to false afterwards if you like.
SETUP_ALLOW_REMOTE=true

# Host ports
WEB_PORT=8080
API_HOST_PORT=4000
DB_HOST_PORT=5433

VITE_TERMINAL_ID=T1
