# Docker Compose settings — copy to .env (`cp .env.example .env`) and change the secrets.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sync_retail

# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Seed demo staff/catalog/sales on first start (only runs while the database is empty)
SEED_DEMO_DATA=true

# Host ports
WEB_PORT=8080
API_HOST_PORT=4000
DB_HOST_PORT=5433

VITE_TERMINAL_ID=T1
